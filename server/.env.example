# Copy to .env and fill in. .env is in .gitignore and must never be committed.

# Random key for signing session cookies:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Hash of the dashboard password (the password itself is never stored):
#   python hash_password.py
DASHBOARD_PASSWORD_HASH=

# Shared secret the ESP32 nodes send in the password field of the protocol.
# Must match SECRET_SERVER_PASSWORD in the firmware's secrets.h.
DEVICE_SHARED_SECRET=

# Database (dedicated user, see schema.sql)
DB_HOST=localhost
DB_USER=autocargo
DB_PASSWORD=
DB_NAME=autocargo

# Delete all messages when the server starts (devices are kept)
CLEAR_MESSAGES_ON_START=true

# Only set to false for local testing without HTTPS
SESSION_COOKIE_SECURE=true
