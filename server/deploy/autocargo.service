# systemd unit: copy to /etc/systemd/system/autocargo.service
# Adjust User and the paths, then: sudo systemctl enable --now autocargo
[Unit]
Description=AutoCargo server
After=network.target mariadb.service

[Service]
User=autocargo
WorkingDirectory=/opt/autocargo/server
EnvironmentFile=/opt/autocargo/server/.env
# One worker: the rate limiter and the start-up cleanup are per process.
ExecStart=/opt/autocargo/server/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 app:app
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
